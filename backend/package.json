{
  "name": "trilha-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "node --test",
    "db:init": "node --env-file=.env scripts/init.js",
    "db:check": "node --env-file=.env scripts/check.js",
    "db:inventory": "node --env-file=.env scripts/inventory.js",
    "db:seed:questions": "node --env-file=.env scripts/seed-questions.js",
    "db:audit": "node --env-file=.env scripts/audit-data.js"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "neo4j-driver": "^6.0.0",
    "nodemailer": "^10.5.0",
    "zod": "^4.1.0"
  }
}
