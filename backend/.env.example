# Modelo público sem senhas reais.
# Integrantes: usem o arquivo trilha-grupo.env recebido como backend/.env.
# O roteiro de instalação está no README.md da raiz.
TCP_HOST=127.0.0.1
TCP_PORT=3002
# Porta do validador Java externo, iniciado à parte na mesma máquina.
JAVA_VALIDATOR_PORT=3001
MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=trilha
NEO4J_URI=neo4j+s://INSTANCIA.databases.neo4j.io
# Use os valores do arquivo de credenciais baixado do Aura.
NEO4J_USERNAME=USUARIO_DA_INSTANCIA
NEO4J_PASSWORD=
NEO4J_DATABASE=NOME_DO_BANCO
JWT_SECRET=
# Habilita o cadastro de professores pelo aplicativo.
ALLOW_TEACHER_REGISTRATION=true

# Confirmação de e-mail para novas contas. Use false somente no ambiente local.
EMAIL_VERIFICATION_REQUIRED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
