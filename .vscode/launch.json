{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Gabariteii — iPhone no Device Hub",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "program": "${workspaceFolder}/frontend/lib/main.dart",
      "flutterMode": "debug",
      "emulatorId": "apple_ios_simulator",
      "toolArgs": ["--dart-define-from-file=${workspaceFolder}/.local/frontend-tcp.json"],
      "preLaunchTask": "Gabariteii: preparar iOS e API"
    }
  ]
}
